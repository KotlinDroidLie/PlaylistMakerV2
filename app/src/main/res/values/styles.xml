<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="ToolBarStyle" parent="MainToolBarStyle">
        <item name="titleTextColor">@color/YP_black</item>
        <item name="navigationIconTint">@color/YP_black</item>
    </style>

    <style name="MainToolBarStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="titleTextColor">@color/white</item>
        <item name="titleTextAppearance">@style/MessageTextStyleYSMedium</item>
    </style>

    <style name="TextViewStyleSettings" parent="MessageTextStyleYSRegular">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/YP_black</item>
        <item name="android:background">@color/white</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/padding_horizontal_standard</item>
        <item name="android:paddingVertical">@dimen/padding_vertical_standard</item>
    </style>
    
    <style name="MessageTextStyleYSMedium">
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">@dimen/text_large</item>
    </style>

    <style name="MessageTextStyleYSRegular">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/text_standard</item>
    </style>

    <style name="MessageTextStyleYSBold">
        <item name="fontFamily">@font/ys_display_bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="SecondLayoutBackground">
        <item name="android:background">@color/white</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ButtonSettingsStyle">
        <item name="android:layout_width">@dimen/size_icon</item>
        <item name="android:layout_height">@dimen/size_icon</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="iconTint">@color/gray</item>
    </style>

    <style name="SearchBar" parent="MessageTextStyleYSRegular">
        <item name="android:textColor">@color/YP_black</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/height_search_bar</item>
        <item name="android:background">@drawable/roundend_edit_text</item>
        <item name="drawableTint">@color/gray</item>
        <item name="android:textColorHint">@color/gray</item>
        <item name="android:inputType">text</item>
        <item name="maxLines">1</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:singleLine">true</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:textCursorDrawable">@drawable/blue_cursor</item>
    </style>

    <style name="ButtonSongDetails">
        <item name="android:layout_width">@dimen/size_icon</item>
        <item name="android:layout_height">@dimen/size_icon</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="iconTint">@color/gray</item>
    </style>

    <style name="TextViewStyleSongName" parent="MessageTextStyleYSRegular">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/YP_black</item>
        <item name="android:textSize">@dimen/text_standard</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextViewStyleSongDetails" parent="MessageTextStyleYSRegular">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/gray</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <style name="ButtonSearchView" parent="MessageTextStyleYSMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">24dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">54dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:backgroundTint">@color/YP_black</item>
    </style>
    
    <style name="TextViewStatusSearchMessage" parent="MessageTextStyleYSMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:drawablePadding">@dimen/padding_drawable_status_search_message</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/YP_black</item>
    </style>

    <style name="IncludeViewStatusSearchMessage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/margin_top_status_search_message</item>
        <item name="android:layout_marginHorizontal">@dimen/margin_text_status_search_message_horizontal</item>
    </style>

    <style name="IncludeViewSearchHistory">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">42dp</item>
        <item name="android:layout_marginHorizontal">@dimen/recycler_view_margin_horizontal</item>
    </style>
    
    <style name="TextViewStyleAudioPlayerSongDetails" parent="MessageTextStyleYSRegular">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/YP_black</item>
        <item name="android:textSize">13sp</item>
        <item name="layout_constrainedWidth">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextViewStyleAudioPlayerSongDescriptionDetails" parent="MessageTextStyleYSRegular">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/gray</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <style name="ImageButtonAudioPlayerStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/rounded_button_audio_player</item>
    </style>
    
    <style name="IncludeViewStatusMediaMessage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/margin_top_status_media_message</item>
        <item name="android:layout_marginHorizontal">@dimen/margin_text_status_media_message_horizontal</item>
    </style>

    <style name="ButtonPlaylistView" parent="MessageTextStyleYSMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">54dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:backgroundTint">@color/YP_black</item>
    </style>

    <style name="TextViewStatusMediaMessage" parent="MessageTextStyleYSMedium">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:drawablePadding">@dimen/padding_drawable_status_search_message</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/YP_black</item>
    </style>

    <style name="TabTextAppearanceMedia" parent="MessageTextStyleYSMedium">
        <item name="textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="MediaTabLayoutStyle" parent="SecondLayoutBackground">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="tabTextColor">@color/YP_black</item>
        <item name="tabIndicatorColor">@color/YP_black</item>
        <item name="tabTextAppearance">@style/TabTextAppearanceMedia</item>
    </style>

    <style name="BottomNavText" parent="MessageTextStyleYSRegular">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="BottomNavigationView" parent="SecondLayoutBackground">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="itemTextAppearanceActive">@style/BottomNavText</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavText</item>
        <item name="itemTextColor">@color/nav_text</item>
        <item name="itemIconTint">@color/nav_icon</item>
        <item name="itemRippleColor">@android:color/transparent</item>
    </style>

    <style name="ButtonCreatePlaylist" parent="MessageTextStyleYSMedium">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="InputFieldPlaylistCreation" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/height_input_text_create_playlist</item>
        <item name="android:textColorHint">@color/YP_black</item>
        <item name="boxStrokeColor">@color/switcher_stroke_color</item>
        <item name="hintTextColor">@color/switcher_stroke_color</item>
        <item name="cursorColor">@color/blue</item>
    </style>


    <style name="EditTextPlaylistCreation" parent="MessageTextStyleYSRegular">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textColor">@color/YP_black</item>
        <item name="android:inputType">text</item>
        <item name="maxLines">1</item>
        <item name="android:imeOptions">actionNext</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TextViewStylePlaylistDetail" parent="MessageTextStyleYSRegular">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/YP_black</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextViewStyleAddToPlaylist" parent="MessageTextStyleYSMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/YP_black</item>
        <item name="android:textSize">19sp</item>
    </style>


    <style name="TextViewPlaylistDetail" parent="MessageTextStyleYSRegular">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/YP_black</item>
        <item name="android:textSize">@dimen/text_standard</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_marginStart">@dimen/margin_small</item>
        <item name="android:layout_marginEnd">@dimen/margin_small</item>
    </style>

    <style name="BottomSheet">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="behavior_hideable">true</item>
        <item name="behavior_peekHeight">auto</item>
        <item name="layout_behavior">com.google.android.material.bottomsheet.BottomSheetBehavior</item>
        <item name="android:background">@drawable/bottom_sheet_shape</item>
    </style>

    <style name="BottomSheetRectangle">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:background">@drawable/bottom_sheet_rectangle</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="TextViewStylePlaylistTitle" parent="MessageTextStyleYSBold">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/YP_black</item>
    </style>

    <style name="TextViewStylePlaylistDescription" parent="MessageTextStyleYSRegular">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/YP_black</item>
        <item name="android:textSize">18sp</item>
    </style>
    
    <style name="TextViewStylePlaylistProperty" parent="TextViewStylePlaylistDescription">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="layout_constrainedWidth">true</item>
    </style>
    
    <style name="ButtonPlaylistAction">
        <item name="android:layout_width">@dimen/icon_size</item>
        <item name="android:layout_height">@dimen/icon_size</item>
        <item name="backgroundTint">@color/YP_black</item>
    </style>
    
    <style name="CustomMaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/blue</item>
    </style>

    <style name="TextViewStyleMenuPlaylist" parent="MessageTextStyleYSRegular">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/YP_black</item>
        <item name="android:background">@color/white</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/padding_horizontal_standard</item>
        <item name="android:paddingVertical">@dimen/padding_vertical_standard</item>
    </style>
</resources>