<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal">

    <Button style="@style/ButtonPlaylistView"
        android:id="@+id/btn_add_new_playlist"
        android:text="@string/new_playlist"/>

    <com.google.android.material.textview.MaterialTextView style="@style/TextViewStatusMediaMessage"
        android:drawableTop="@drawable/ic_search_nothing_120"
        android:text="@string/no_playlist_has_been_created"
        android:layout_marginTop="46dp"/>

</LinearLayout>