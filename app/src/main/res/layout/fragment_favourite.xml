<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_favourite_media"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/recycler_view_margin_horizontal"
        android:visibility="visible"/>

    <include style="@style/IncludeViewStatusMediaMessage"
        layout="@layout/favourite_media_is_empty_view"
        android:id="@+id/view_media_favourite_status_is_empty"
        android:visibility="gone"/>

</FrameLayout>