<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout style="@style/SecondLayoutBackground"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:id="@+id/iv_poster_playlist"
        android:layout_width="@dimen/poster_playlist_size"
        android:layout_height="@dimen/poster_playlist_size"
        app:layout_constraintBottom_toTopOf="@+id/tv_playlist_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_placeholder_312" />

    <com.google.android.material.textview.MaterialTextView style="@style/TextViewStylePlaylistDetail"
        android:id="@+id/tv_playlist_title"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_playlist_total_tracks"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_poster_playlist"
        tools:text="Summer Party" />

    <com.google.android.material.textview.MaterialTextView style="@style/TextViewStylePlaylistDetail"
        android:id="@+id/tv_playlist_total_tracks"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_playlist_title"
        tools:text="157 треков" />

</androidx.constraintlayout.widget.ConstraintLayout>