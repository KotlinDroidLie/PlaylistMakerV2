<?xml version="1.0" encoding="utf-8"?>
<LinearLayout style="@style/SecondLayoutBackground"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search">

    <com.google.android.material.appbar.MaterialToolbar style="@style/ToolBarStyle"
        android:id="@+id/button_back_search"
        app:navigationIcon="@drawable/ic_arrow_back_16"
        app:title="@string/text_search"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/standart_padding"
        android:paddingVertical="8dp">

        <EditText style="@style/SearchBar"
            android:id="@+id/editText"
            android:hint="@string/text_search"
            android:drawableStart="@drawable/ic_search_16"/>

        <ImageView style="@style/SearchBar"
            android:id="@+id/clear_text"
            android:layout_gravity="end"
            android:layout_width="wrap_content"
            android:src="@drawable/ic_clear_40x36"
            android:visibility="gone"/>
    </FrameLayout>

</LinearLayout>